// Name/UID3 are frozen in mmfaudioserverdecs.h and mmfaudiosvruids.hrh.
TARGET          MMFAudioServerStart.exe
TARGETTYPE      exe
UID             0x100039CE 0x101F457F
CAPABILITY      All -TCB -AllFiles -DiskAdmin -NetworkControl -SwEvent -TrustedUI
VENDORID        0x70000001
EPOCSTACKSIZE   0x8000
EPOCHEAPSIZE    0x1000 0x1000000

SOURCEPATH      src
SOURCE          mmfaudioserverstart.cpp
USERINCLUDE     ../../oss.FCL.sf.os.mmaudio/devsound/a3fdevsound/inc

#include <platform_paths.hrh>
OS_LAYER_SYSTEMINCLUDE_SYMBIAN

LIBRARY         euser.lib mmfaudioserver.lib
